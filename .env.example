APPLICATION__NAME=mentor-ai
APPLICATION__VERSION=0.1.0
APPLICATION__ENVIRONMENT=development
APPLICATION__DEBUG=true
APPLICATION__DOCS=/docs
APPLICATION__REDOC=/redoc
APPLICATION__SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
APPLICATION__TIMEZONE=UTC
APPLICATION__API_PREFIX=/api/v1
APPLICATION__HOST=0.0.0.0
APPLICATION__PORT=8000
APPLICATION__WORKERS=1
APPLICATION__RELOAD=true
APPLICATION__ALLOWED_HOSTS=["localhost","127.0.0.1"]
APPLICATION__ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APPLICATION__TRUSTED_PROXIES=["127.0.0.1/32","::1/128","172.16.0.0/12"]

DATABASE__HOST=localhost
DATABASE__PORT=5433
DATABASE__USER=mentor
DATABASE__PASSWORD=mentor-dev-password
DATABASE__NAME=mentor_ai
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__PRE_PING=true
DATABASE__ECHO=false
DATABASE__SSL_MODE=disable
DATABASE__VERSION=postgres:17-bookworm

BOT__TOKEN=123456789:replace-with-your-telegram-bot-token
BOT__TYPE=polling
BOT__ADMIN_IDS=[]

# LLM. Leave LLM__GROQ_API_KEY empty to force the Ollama fallback.
LLM__PROVIDER=groq
LLM__GROQ_API_KEY=
LLM__GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM__GROQ_MODEL=openai/gpt-oss-120b
LLM__OLLAMA_BASE_URL=http://localhost:11434/v1
LLM__OLLAMA_MODEL=qwen2.5:3b
LLM__CONTEXT_MESSAGES=20
LLM__MAX_TOKENS=1024
LLM__TEMPERATURE=0.7

# Email digest. Leave MAIL__HOST empty to disable SMTP delivery entirely;
# the UI will then honestly report that email is not configured.
MAIL__HOST=
MAIL__PORT=587
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__FROM_ADDRESS=
MAIL__USE_TLS=true

# Host port exposed by docker compose for the api service.
# Change it if port 8000 is already taken on your machine.
API_HOST_PORT=8000

# Voice assistant (KittenTTS 2).
# KITTEN__BACKEND=auto uses the hosted API when KITTEN__API_KEY is set, else local.
# KITTEN__BACKEND=local runs the model on this machine (no key, needs torch + HF download).
# KITTEN__BACKEND=hosted always calls https://api.kittenml.com and needs KITTEN__API_KEY.
KITTEN__BACKEND=auto
KITTEN__API_KEY=
KITTEN__BASE_URL=https://api.kittenml.com/v1
KITTEN__MODEL=kitten-tts-2-latest
KITTEN__LOCAL_REPO=KittenML/kitten-tts-2
KITTEN__DEVICE=auto
KITTEN__VOICE=
KITTEN__REFERENCE=
# Local transcription only (hosted uses kitten-asr-pro-enhanced).
# openai/whisper-small is a good default; use openai/whisper-large-v3 for accuracy.
KITTEN__STT_MODEL=openai/whisper-small
KITTEN__STT_LANGUAGE=ru
KITTEN__SAMPLE_RATE=24000
KITTEN__MAX_INPUT_CHARS=4000
